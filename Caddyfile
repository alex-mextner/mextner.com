# Origin for mextner.com on the home server (odroid), served by caddy-mextner.service.
# Cloudflare Tunnel terminates TLS and forwards mextner.com / www.mextner.com here,
# so this instance listens on plain HTTP, loopback only.
{
	admin off
	auto_https off
}

http://:8081 {
	bind 127.0.0.1

	# Redirect www to non-www
	@www host www.mextner.com
	redir @www https://mextner.com{uri} permanent

	root * /var/www/mextner.com
	file_server
	encode gzip

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Handle clean URLs for Hugo
	try_files {path} {path}.html {path}/

	# Custom 404 page
	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		rewrite @404 /404.html
		file_server
	}

	# Always revalidate CSS and JS
	@css_js {
		path *.css *.js
	}
	header @css_js {
		Cache-Control "no-cache"
	}

	# Cache images for 1 hour
	@images {
		path *.jpg *.jpeg *.png *.gif *.svg *.webp *.ico
	}
	header @images {
		Cache-Control "public, max-age=3600"
	}

	# Cache fonts for 1 year
	@fonts {
		path *.woff *.woff2 *.ttf *.eot *.otf
	}
	header @fonts {
		Cache-Control "public, max-age=31536000, immutable"
	}

	# Always revalidate HTML
	@html {
		path *.html
	}
	header @html {
		Cache-Control "no-cache"
	}

	log {
		output stdout
		format console
	}
}
